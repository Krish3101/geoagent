FROM python:3.11-slim
WORKDIR /app

# Install system dependencies for shapely / geopandas / OSmnx
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# Install shared dependency first
COPY shared /app/shared
RUN pip install -e /app/shared

# Copy vector agent dependency files
COPY vector_agent/requirements.txt /app/vector_agent/
RUN pip install --no-cache-dir -r /app/vector_agent/requirements.txt

# Copy vector agent source code
COPY vector_agent /app/vector_agent

WORKDIR /app/vector_agent
EXPOSE 8001
ENV PYTHONPATH=/app/vector_agent
CMD ["python", "-m", "src.main"]
