FROM python:3.11-slim
WORKDIR /app

# Install system dependencies for planetary-computer, odc-stac, and rioxarray
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# Install shared dependency first
COPY shared /app/shared
RUN pip install -e /app/shared

# Copy raster agent dependency files
COPY raster_agent/requirements.txt /app/raster_agent/
RUN pip install --no-cache-dir -r /app/raster_agent/requirements.txt

# Copy raster agent source code
COPY raster_agent /app/raster_agent

WORKDIR /app/raster_agent
EXPOSE 8002
ENV PYTHONPATH=/app/raster_agent
CMD ["python", "-m", "src.main"]
