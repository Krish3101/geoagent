# ================================================
# GeoAgent — Environment Configuration Template
# ================================================
# Copy this file to the root directory:
#   cp .env.example .env
# Then fill in your actual values.

# ---- Authentication ----
# Bearer token required by all protected API endpoints.
# Clients must send: Authorization: Bearer <token>
# Change this to a secure, randomly-generated string in production.
GEO_AGENT_SECRET_TOKEN=default_secret_token_123

# ---- LLM Configuration ----
# API key for accessing LLM capabilities via OpenRouter (https://openrouter.ai/).
# Required for the /api/chat endpoint.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM model identifier (see https://openrouter.ai/docs#models).
LLM_MODEL=google/gemma-3-27b-it

# ---- Database ----
# SQLAlchemy connection string for task/log persistence.
# Defaults to a local SQLite file if not set.
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/geoagent
DATABASE_URL=sqlite:///./geoagent.db

# ---- Redis (Optional) ----
# Redis URL for distributed state management (task statuses, WebSocket connections).
# If unset or unreachable, the agent falls back to in-memory state.
# REDIS_URL=redis://localhost:6379/0

PORT=8000

# ---- Logging ----
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
